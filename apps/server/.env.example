# Server-only configuration. Nothing here is ever sent to the browser.
PORT=8787
# Comma-separated list of allowed browser origins ("*" for any)
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/keyring.sqlite
# Enables /api/debug and the x-keyring-debug header (defaults to on outside production)
# ENABLE_DEBUG=true
RATE_LIMIT_PER_MINUTE=20
# Optional real LLM. When set, "Claude" appears in the model picker; mock stays available.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
